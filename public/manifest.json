{
  "manifest_version": 3,
  "name": "Local LLM Translator",
  "short_name": "Local LLM Translator",
  "description": "Translate pages and selections through a local or self-hosted LLM endpoint.",
  "version": "0.1.0",
  "action": {
    "default_icon": {
      "16": "icon/16.png",
      "32": "icon/32.png",
      "48": "icon/48.png",
      "128": "icon/128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Local LLM Translator"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "toggle-page-translation": {
      "description": "Toggle page translation",
      "suggested_key": {
        "default": "Alt+A"
      }
    },
    "translate-selection": {
      "description": "Translate selected text",
      "suggested_key": {
        "default": "Alt+E"
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "local_llm_ruleset",
        "enabled": true,
        "path": "rules/request_modifier_rule.json"
      }
    ]
  },
  "host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "64": "icon/64.png",
    "128": "icon/128.png",
    "512": "icon/512.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "commands", "declarativeNetRequest", "storage", "tabs"]
}
